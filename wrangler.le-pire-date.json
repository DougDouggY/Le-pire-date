{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-pire-date",
  "main": "worker/cloudflare.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "le-pire-date-db",
      "database_id": "5346c540-0b83-4e19-9675-55489202c21f",
      "migrations_dir": "./drizzle"
    }
  ]
}
